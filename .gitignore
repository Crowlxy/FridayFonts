# Built faces and everything derived from them.  The fonts are large and
# reproducible from the source and this tree; what has to be under version
# control is the build, not its output.
fonts/
fonts-v*/
previews/
*.log
__pycache__/
.venv/
.DS_Store

# Reference material that cannot be redistributed.  SF Mono is under Apple's
# EULA and Hiragino under Screen's; both are measured, never shipped, and must
# never enter a repository that could be pushed.
../Source/SFMonoFonts/
../Source/Hiragino Sans/

# The build's own virtualenv.  fontTools disappeared from the system python
# mid-project and every build after that ran from a throwaway venv, so it is
# pinned here now -- but the packages themselves do not belong in the repo.
.venv/

# Release archive (over GitHub's 100 MB file limit) and its checksum; the
# unpacked release is kept in dist-v46/.
InoriMono-v*.zip
InoriMono-v*.zip.sha256

# Superseded builds, moved aside by hand.
過去Ver/

# Review and comparison output, regenerated by the audit and make_* scripts.
review-v*/
cmp/

# Trial builds handed out for testing before a release.
trial-*/

# Chlorophytum's packages and its per-face analysis cache (cjkhint.py).
chlorophytum/node_modules/
chlorophytum/cache/
FridayMono-v*.zip
FridayMono-v*.zip.sha256
FridaySans-*.zip
FridaySans-*.zip.sha256

# Friday Sans build outputs (sans/).
work/
fonts-hinted/
trial/
